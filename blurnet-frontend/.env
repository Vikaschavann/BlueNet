# ============================================================
# BlueNet Frontend - Environment Variables (Vite)
# All variables MUST start with VITE_ to be accessible in code
# ============================================================

# --- Google OAuth ---

# Same Google OAuth Client ID as the backend
# Go to: https://console.cloud.google.com/apis/credentials
# Make sure to add http://localhost:5173 to "Authorized JavaScript origins"
VITE_GOOGLE_CLIENT_ID=213073519421-pvp7t8uopebnh3a8ekcmkphhup4dsp9j.apps.googleusercontent.com
# --- Backend WebSocket URLs ---

# WebSocket URL for the meeting/signaling server (room connections)
# Default (local dev): ws://localhost:8000/ws/room
VITE_SIGNALING_WS_BASE=ws://localhost:8000/ws/room

# WebSocket URL for the AI moderation engine
# Default (local dev): ws://localhost:8000/ws/moderate
VITE_MODERATION_WS=ws://localhost:8000/ws/moderate

# --- Backend API URL ---
# Note: AuthContext.jsx currently has http://localhost:8000 hardcoded.
# For production, you should refactor to use this variable:
# VITE_API_BASE_URL=http://localhost:8000
