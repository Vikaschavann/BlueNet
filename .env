# ============================================================
# BlueNet Backend - Environment Variables
# ============================================================

# --- Authentication ---

# Secret key used to sign JWT tokens. 
# IMPORTANT: Change this to a long, random string in production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=hiithisisvish

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Go to: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID → Web application
# Copy the Client ID and paste it here
GOOGLE_CLIENT_ID=213073519421-pvp7t8uopebnh3a8ekcmkphhup4dsp9j.apps.googleusercontent.com
# --- Database ---
# Currently using SQLite (hardcoded in database.py). No env var needed.
# If you migrate to PostgreSQL later, add:
# DATABASE_URL=postgresql://user:password@localhost:5432/bluenet

# --- Server ---
# These are hardcoded in main.py but can be overridden:
# HOST=0.0.0.0
# PORT=8000
